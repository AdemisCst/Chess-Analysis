# ==========================================================================
# ACERVO 64 - variáveis do assistente publicado (Vercel)
#
# Copie este arquivo como referência ao configurar o projeto na Vercel
# (Settings -> Environment Variables). NÃO envie este arquivo para o GitHub
# com chaves reais: use apenas nomes e valores de exemplo.
#
# O aplicativo funciona sem nenhuma destas variáveis. Sem elas, a aba do
# assistente mostra "offline" e a Leitura do Acervo usa o modo local
# determinístico (calculado no próprio navegador).
# ==========================================================================

# --------------------------------------------------------------------------
# 1. QUEM PODE USAR
# --------------------------------------------------------------------------
# code = cada pessoa precisa informar um código (recomendado para 20 pessoas)
# ip   = cota por endereço IP (mais simples, menos preciso atrás de NAT)
# AI_ACCESS_MODE=code

# Lista separada por vírgulas. Distribua um código por pessoa; para revogar,
# remova o código e salve novamente.
# AI_ACCESS_CODES=AMIGO-1,AMIGO-2,AMIGO-3

# Ações por pessoa por dia e total do site por dia.
# AI_DAILY_PER_USER=20
# AI_DAILY_GLOBAL=500

# --------------------------------------------------------------------------
# 2. PROVEDOR PRINCIPAL
# --------------------------------------------------------------------------
# ollama = contrato /api/chat (NDJSON)
# openai = qualquer serviço compatível com OpenAI (/chat/completions)
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.exemplo.com/v1
# AI_API_KEY=sk-substitua-por-sua-chave
# AI_MODEL=modelo-pequeno-e-barato
# AI_CHAT_PATH=/chat/completions   (opcional; sobrescreve o caminho padrão)

# Exemplos de provedores compatíveis com OpenAI:
#   Groq        AI_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter  AI_BASE_URL=https://openrouter.ai/api/v1
#   Together    AI_BASE_URL=https://api.together.xyz/v1
#   DeepSeek    AI_BASE_URL=https://api.deepseek.com/v1

# --------------------------------------------------------------------------
# 3. PROVEDOR DE RESERVA (opcional)
# --------------------------------------------------------------------------
# Usado quando o principal devolve erro ou está fora do ar. Pode ser outro
# modelo do mesmo serviço ou um provedor diferente.
# AI_FALLBACK_PROVIDER=openai
# AI_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# AI_FALLBACK_API_KEY=chave-de-reserva
# AI_FALLBACK_MODEL=modelo-de-reserva

# --------------------------------------------------------------------------
# 4. COTAS DURÁVEIS (opcional, recomendado)
# --------------------------------------------------------------------------
# Sem Redis, as cotas e o cache vivem na memória de cada instância da Vercel:
# funcionam, mas são reiniciadas em novos deploys e não são compartilhadas
# entre instâncias. O Upstash tem plano gratuito suficiente para este uso.
# Crie um banco Redis em https://upstash.com e copie as duas variáveis.
# UPSTASH_REDIS_REST_URL=https://exemplo.upstash.io
# UPSTASH_REDIS_REST_TOKEN=substitua-pelo-token

# --------------------------------------------------------------------------
# 5. OLLAMA LOCAL (opcional, fora da Vercel)
# --------------------------------------------------------------------------
# Em vez de publicar um provedor pago, você pode deixar o Ollama rodando no
# seu PC e expô-lo por um túnel. Nesse caso, na Vercel:
# AI_PROVIDER=ollama
# AI_BASE_URL=https://seu-tunel.exemplo.com
# AI_MODEL=qwen2.5:3b
# A chave é opcional para Ollama; se o túnel exigir autenticação, use AI_API_KEY.
