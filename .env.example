# ==========================================================================
# Chess-Analysis — variáveis de ambiente (Vercel)
#
# Copie os nomes para Settings → Environment Variables no painel da Vercel.
# NUNCA versione este arquivo com uma chave real. Este arquivo é apenas um
# modelo versionado; os arquivos .env e .env.local ficam fora do Git.
#
# Sem estas variáveis o aplicativo continua funcionando: biblioteca,
# Stockfish, estatísticas e PDF operam localmente. Apenas o Treinador IA
# externo fica desabilitado, com mensagem clara na interface.
# ==========================================================================

# --------------------------------------------------------------------------
# 1. PROVEDOR DE IA (obrigatório para o Treinador IA externo)
# --------------------------------------------------------------------------
# Provedor compatível com a API OpenAI. O servidor (api/chat.js) é quem fala
# com o provedor; a chave nunca chega ao navegador.
# Configuração oficial do Chess-Analysis: Groq.
AI_PROVIDER=openai
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=coloque-a-chave-real-somente-na-vercel

# A chave precisa ser real. Valores de exemplo como "sua_chave", "sk-substitua"
# ou textos com menos de 20 caracteres são recusados pelo servidor em vez de
# serem enviados ao provedor (isso evita o erro genérico "Invalid API Key").

# --------------------------------------------------------------------------
# 2. TOKENS DE SAÍDA (opcional)
# --------------------------------------------------------------------------
# Teto de tokens da resposta, aplicado somente no servidor. O navegador não
# escolhe esse valor. Padrão: 4096. Faixa aceita: 256 a 32768.
AI_MAX_TOKENS=4096

# --------------------------------------------------------------------------
# 3. COTAS (recomendado)
# --------------------------------------------------------------------------
# Cota por IP por dia e cota global do site por dia. Sem Redis, os contadores
# ficam na memória de cada instância do servidor: funcionam como proteção
# básica, mas são reiniciados em novos deploys.
AI_DAILY_PER_USER=20
AI_DAILY_GLOBAL=500

# --------------------------------------------------------------------------
# 4. REDIS OPCIONAL (Upstash REST)
# --------------------------------------------------------------------------
# Necessário apenas para cotas duráveis e compartilhadas entre instâncias.
# UPSTASH_REDIS_REST_URL=https://exemplo.upstash.io
# UPSTASH_REDIS_REST_TOKEN=substitua-pelo-token

# --------------------------------------------------------------------------
# 5. PROVEDOR DE RESERVA (opcional)
# --------------------------------------------------------------------------
# Usado se o principal devolver erro. Pode ser o mesmo provedor com outro
# modelo, ou outro provedor compatível. O modelo de reserva também é definido
# aqui, nunca pelo navegador.
# AI_FALLBACK_PROVIDER=openai
# AI_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# AI_FALLBACK_API_KEY=chave-de-reserva
# AI_FALLBACK_MODEL=openai/gpt-oss-20b
# AI_FALLBACK_MAX_TOKENS=4096

# --------------------------------------------------------------------------
# 6. CAMINHO PERSONALIZADO (opcional)
# --------------------------------------------------------------------------
# Sobrescreve o caminho padrão de conversa (/chat/completions) quando o
# provedor usa outra rota.
# AI_CHAT_PATH=/chat/completions
